{
  "name": "claude-coding-hub",
  "version": "0.1.0",
  "description": "A local MCP hub that lets Claude Code delegate work to other coding agents (Codex, Gemini, Grok, OpenCode) while a human approves every risky action.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnJoshua03/claude-coding-hub.git"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "gemini",
    "agent-client-protocol",
    "ai-agents",
    "security"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "start": "node dist/server.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
